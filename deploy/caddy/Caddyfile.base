{
  admin 0.0.0.0:2019
  email {$SELFYURT_LETSENCRYPT_EMAIL}
}

(panel_proxy) {
  encode zstd gzip

  @api path /api /api/*
  handle @api {
    reverse_proxy api:8787
  }

  handle {
    reverse_proxy web:8080
  }

  header {
    X-Frame-Options "DENY"
    X-Content-Type-Options "nosniff"
    Referrer-Policy "strict-origin-when-cross-origin"
  }
}

# Domain panel route (automatic HTTPS when DNS is ready)
{$SELFYURT_PANEL_HOST:localhost} {
  import panel_proxy
}

# IP/HTTP bootstrap route for first setup
:80 {
  import panel_proxy
}

# Agent writes dynamic app routes here as full host blocks
import /etc/caddy/generated/*.caddy
